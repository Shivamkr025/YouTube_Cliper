# Virtual Environment
venv/
.venv/
env/

# Workspace & Temp Media
workspace/raw_videos/*
!workspace/raw_videos/.gitkeep
workspace/temp/*
!workspace/temp/.gitkeep
workspace/final_shorts/*
!workspace/final_shorts/.gitkeep

